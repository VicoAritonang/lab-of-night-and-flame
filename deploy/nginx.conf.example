# Replace domain and certificate paths. API/WS terminate on this host, not Lambda.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 443 ssl;
  server_name YOUR-SYNC-DOMAIN;
  ssl_certificate /etc/letsencrypt/live/YOUR-SYNC-DOMAIN/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/YOUR-SYNC-DOMAIN/privkey.pem;
  client_max_body_size 128m;
  location /api/ {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 125s;
  }
}
