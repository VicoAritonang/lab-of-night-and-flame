# Provider keys (read from environment only; never persisted)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional: protect the API/UI with an owner token
ARL_AUTH_TOKEN=
# Optional: OpenAI-compatible local server (Ollama, vLLM, LM Studio)
ARL_LOCAL_BASE_URL=http://host.docker.internal:11434/v1

# Per-provider request-per-minute limits (token bucket). Lower OpenRouter to 20 on the free tier.
ARL_OPENROUTER_RPM=120
ARL_OPENAI_RPM=300
ARL_GROQ_RPM=30
