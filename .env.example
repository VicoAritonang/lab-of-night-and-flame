# PostgreSQL. docker compose sets this for you. NEON_DB_URL is accepted as an alias.
# For Neon prefer the pooled endpoint and keep TLS enabled.
ARL_DATABASE_URL=postgres://arl:arl@localhost:5432/arl?sslmode=disable

# All-in-one development mode (defaults shown; the Docker image enables the first two).
# ARL_AUTO_MIGRATE=false        # apply sql/init.sql at startup
# ARL_LISTEN_ON_START=false     # accept agents without pressing "Start listening"
# ARL_EMBEDDED_WORKER=true      # run jobs in process when ARL_SQS_QUEUE_URL is empty
# ARL_SERVE_UI=true             # serve the embedded web UI on /

# Modules (default all). Presets: tracing = traces,otel,monitor;
# agent = tracing + quality,workbench,suites,prompts,playground;
# eval = datasets,experiments,playground,perf. Combine and subtract freely:
# ARL_FEATURES=agent,-playground   or   ARL_FEATURES=all,-perf
# ARL_FEATURES=all

# SYNC host only. Bind loopback behind the supplied nginx TLS configuration.
ARL_ADDR=127.0.0.1:8000
ARL_AUTH_TOKEN=
ARL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-VERCEL-DOMAIN
ARL_SQS_QUEUE_URL=
AWS_REGION=ap-southeast-1
ARL_DB_MAX_CONNS=4
ARL_MAX_HTTP=48
ARL_MAX_WS=100

# ASYNC worker configuration. Supply these to Lambda / the local worker.
ARL_WORKER_CONCURRENCY=4
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ARL_LOCAL_BASE_URL=http://localhost:11434/v1
ARL_OPENROUTER_RPM=120
ARL_OPENAI_RPM=300
ARL_GROQ_RPM=30

# External service instrumentation (not required by the lab itself):
# LAB_WS_URL=wss://YOUR-SYNC-DOMAIN/api/agent-lab/ws
# STAGE=dev
# LAB_TOKEN=<same value as ARL_AUTH_TOKEN>
# LAB_PROJECT_ID=default
# LAB_REQUIRED=false
