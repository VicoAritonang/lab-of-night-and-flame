# Public endpoint only. Never put database credentials or owner/provider tokens in VITE_*.
# Optional when frontend and WebSocket gateway share lab.vicoworks.com.
# Required for split hosting (e.g. Vercel frontend + separate SYNC gateway).
VITE_LAB_WS_URL=wss://YOUR-SYNC-DOMAIN/api/agent-lab/ws
# Canonical SEO domain is already https://lab.vicoworks.com (src/site.ts).
